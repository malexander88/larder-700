{
  "name": "larder-700",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0 -p 3847",
    "build": "tsx scripts/validate.ts && tsx scripts/export-library.ts && next build",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/larder-700 npm run build",
    "cap:sync": "npx cap sync android",
    "apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "start": "next start -H 0.0.0.0 -p 3847",
    "lint": "eslint",
    "validate": "tsx scripts/validate.ts",
    "schema": "tsx scripts/generate-schema.ts",
    "image": "tsx scripts/optimize-image.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.80.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.23.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "zod-to-json-schema": "^3.25.2"
  }
}
