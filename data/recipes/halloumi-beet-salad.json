  "steps": [
    {
      "minutes": 6,
      "instruction": "Rinse the quinoa. Cube the beetroot and peel and slice the orange. Slice the halloumi."
    },
    {
      "minutes": 14,
      "instruction": "Simmer the quinoa in the water with a pinch of salt until the grains have opened and the water is absorbed. Leave it covered.",
      "heat": "low hob"
    },
    {
      "minutes": 5,
      "instruction": "Warm half the oil and fry the halloumi until golden on both sides.",
      "heat": "medium hob"
    },
    {
      "minutes": 4,
      "instruction": "Fold the chickpeas, beetroot, orange, rocket and mint through the quinoa with the lemon juice and the rest of the oil. Top with the halloumi."
    }
