  "steps": [
    {
      "minutes": 8,
      "instruction": "Slice the steak, celery, ginger, garlic and spring onion. Stir the cornflour into the tamari with a tablespoon of water. Rinse the rice."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in the rest of the water with a pinch of salt, covered, for 10 minutes. Leave it covered.",
      "heat": "low hob"
    },
    {
      "minutes": 4,
      "instruction": "Heat the sesame oil and sear the steak until just browned. Lift it out.",
