  "steps": [
    {
      "minutes": 10,
      "instruction": "Heat the fan oven to 200°C. Mix the turkey with half the onion, half the garlic, the spices, half the parsley and half the salt. Shape into eight ovals and set them on a lightly oiled tin.",
      "temperatureC": 200,
      "tip": "Wet hands stop the mince sticking. A little oil on the tin is enough."
    },
    {
      "minutes": 14,
      "instruction": "Bake the kofta until browned and cooked through. Start the rice in the water when the kofta goes in.",
      "temperatureC": 200
    },
    {
      "minutes": 5,
      "instruction": "Stir the remaining garlic into the yoghurt. Toss the cucumber, tomato, remaining onion, lettuce and parsley with the lemon juice and a pinch of salt."
    },
    {
      "minutes": 2,
      "instruction": "Serve the kofta with the rice, salad and yoghurt."
    }
