  "steps": [
    {
      "minutes": 10,
      "instruction": "Heat the fan oven to 200°C. Brush the aubergine with 2 teaspoons of the oil, season lightly and lay it in the tin.",
      "temperatureC": 200
    },
    {
      "minutes": 18,
      "instruction": "Roast the aubergine until it is soft and browned. Turn the slices halfway.",
      "temperatureC": 200,
      "tip": "Pale, spongy aubergine needs longer, not more oil."
    },
    {
      "minutes": 12,
      "instruction": "Push the aubergine to one side. Toss the onion, tomatoes, lentils, garlic, oregano and remaining oil into the gap and roast until the tomatoes burst.",
      "temperatureC": 200
    },
    {
      "minutes": 4,
      "instruction": "Stir the spinach through the hot lentils, crumble over the feta and return the tin to the oven for a couple of minutes. Finish with lemon juice and parsley."
