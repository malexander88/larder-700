  "steps": [
    {
      "minutes": 8,
      "instruction": "Cube and dry the tofu and toss it with the five-spice and a pinch of salt. Halve the pak choi and slice the garlic. Rinse the rice."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in the water with a pinch of salt, covered, for 10 minutes. Leave it covered.",
      "heat": "low hob"
    },
    {
      "minutes": 6,
      "instruction": "Heat the sesame oil and fry the tofu until golden. Push it aside.",
      "heat": "high hob"
    },
    {
      "minutes": 4,
      "instruction": "Add the pak choi and garlic and stir-fry until the leaves wilt. Splash in the tamari.",
      "heat": "high hob"
    },
    {
      "minutes": 2,
      "instruction": "Serve the tofu and pak choi on the rice and scatter over the sesame seeds."
    }
