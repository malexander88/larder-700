  "steps": [
    {
      "minutes": 10,
      "instruction": "Heat the oven to 200°C fan. Dry and cube the tofu. Drain the chickpeas. Cut the cauliflower and onion. Stir the yoghurt with the garlic, garam masala, paprika, turmeric, cumin, oil and salt."
    },
    {
      "minutes": 6,
      "instruction": "Toss the tofu, cauliflower, chickpeas and onion in the yoghurt mix and spread them in the tin."
    },
    {
      "minutes": 22,
      "instruction": "Roast until the cauliflower is tender and the edges are browned, turning once.",
      "temperatureC": 200
    },
    {
      "minutes": 3,
      "instruction": "Squeeze over the lemon juice, scatter with coriander and serve from the tin."
    }
