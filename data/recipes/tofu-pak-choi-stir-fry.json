  "steps": [
    {
      "minutes": 8,
      "instruction": "Press the tofu between a board and a tea towel for a few minutes, cube it and dust it with the cornflour. Start the rice in 180 g of water.",
      "tip": "Cornflour is what makes the edges crisp. Wet tofu just steams."
    },
    {
      "minutes": 6,
      "instruction": "Heat the rapeseed oil and fry the tofu, turning, until golden on two sides. Lift it out.",
      "heat": "medium-high hob"
    },
    {
      "minutes": 5,
      "instruction": "Fry the ginger and garlic, then add the carrot, mangetout and pak choi. Splash in the tamari and a tablespoon of water and toss until the greens wilt.",
      "heat": "high hob"
    },
    {
      "minutes": 3,
      "instruction": "Return the tofu, add the sesame oil and spring onion, and toss gently so the cubes don't break up. Serve over the rice."
    }
