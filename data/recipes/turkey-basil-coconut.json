  "steps": [
    {
      "minutes": 8,
      "instruction": "Halve the beans and slice the pak choi, ginger and chilli. Pick the basil. Rinse the rice."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in the water with a pinch of salt, covered, for 10 minutes. Leave it covered.",
      "heat": "low hob"
    },
    {
      "minutes": 6,
      "instruction": "Warm the oil and fry the mince until it loses its pink colour.",
      "heat": "medium hob"
    },
    {
      "minutes": 4,
      "instruction": "Add the ginger, chilli and beans and stir-fry for 2 minutes.",
      "heat": "medium hob"
    },
    {
      "minutes": 6,
      "instruction": "Pour in the coconut milk, tamari and salt. Simmer, then add the pak choi until it wilts.",
      "heat": "low hob"
    },
    {
      "minutes": 2,
      "instruction": "Stir in the lime juice and basil and serve with the rice."
