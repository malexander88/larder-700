  "steps": [
    {
      "minutes": 10,
      "instruction": "Toss the chicken with the paprika, cumin, oregano, garlic and half the salt. Start the rice in the water, covered, over a low heat.",
      "heat": "low hob"
    },
    {
      "minutes": 8,
      "instruction": "Heat the oil in the frying pan until it shimmers. Fry the chicken in a single layer until golden, then scoop it out.",
      "heat": "high hob",
      "tip": "If you stir constantly the chicken won't colour. Leave it alone for a minute."
    },
    {
      "minutes": 8,
      "instruction": "Fry the onion and peppers in the same pan until they soften and pick up the brown bits. Return the chicken with the beans and sweetcorn and warm through.",
      "heat": "medium-high hob"
    },
    {
      "minutes": 4,
      "instruction": "Squeeze in the lime juice, taste for salt and fold through the coriander. Serve over the rice with the little gem on the side."
    }
