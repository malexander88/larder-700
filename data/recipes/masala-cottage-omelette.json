  "steps": [
    {
      "minutes": 6,
      "instruction": "Chop the onion, tomatoes, chilli, spinach and coriander. Rinse the rice. Beat the eggs with the turmeric, half the cumin and half the salt."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in the water with a pinch of salt, covered, for 10 minutes. Leave it covered.",
      "heat": "low hob"
    },
    {
      "minutes": 5,
      "instruction": "Warm half the oil and cook the onion and chilli for 2 minutes. Add the tomatoes, spinach and the rest of the cumin and salt. Tip the mixture into a bowl and stir in the cottage cheese and coriander.",
      "heat": "medium hob"
    },
    {
      "minutes": 6,
      "instruction": "Add the rest of the oil and pour in half the egg. When the base is set, spoon on half the filling and fold. Repeat with the rest.",
      "heat": "medium hob"
    },
    {
      "minutes": 2,
      "instruction": "Serve the omelettes with the rice and the yoghurt on the side."
    }
