  "steps": [
    {
      "minutes": 6,
      "instruction": "Separate and rinse the lettuce leaves. Grate the carrot, ginger and garlic. Slice the spring onion and rinse the rice."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in the water with a pinch of salt, covered, for 10 minutes, then leave it covered off the heat.",
      "heat": "low hob"
    },
    {
      "minutes": 8,
      "instruction": "Warm the oil and fry the mince, breaking it up, until it browns. Add the ginger, garlic and carrot and cook for another 2 minutes.",
      "heat": "medium hob"
    },
    {
      "minutes": 3,
      "instruction": "Stir in the tamari, lime juice, chilli and half the spring onion. Taste for salt.",
      "heat": "low hob"
    },
    {
      "minutes": 2,
      "instruction": "Spoon the mince into the lettuce leaves, top with sesame seeds and the rest of the spring onion, and serve with the rice."
    }
