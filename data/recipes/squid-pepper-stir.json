  "steps": [
    {
      "minutes": 8,
      "instruction": "Slice the squid into rings and pat it dry. Soak the noodles until they bend, then drain. Slice the pepper, ginger, garlic and spring onion."
    },
    {
      "minutes": 4,
      "instruction": "Heat the sesame oil and stir-fry the pepper, ginger and garlic for 2 minutes.",
      "heat": "high hob"
    },
    {
      "minutes": 3,
      "instruction": "Add the squid and cook only until the rings turn opaque.",
      "heat": "high hob",
      "tip": "Squid turns rubbery if it sits in the pan. Take it off as soon as it is white."
    },
    {
      "minutes": 2,
      "instruction": "Toss in the noodles, beansprouts, tamari, chilli and spring onion and serve."
    }
