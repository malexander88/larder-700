  "steps": [
    {
      "minutes": 8,
      "instruction": "Heat the fan oven to 200°C. Stir the harissa with the oil and garlic. Toss the pepper, courgette, onion and chickpeas with half of that paste and a pinch of salt.",
      "temperatureC": 200
