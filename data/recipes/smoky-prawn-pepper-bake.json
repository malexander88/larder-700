  "steps": [
    {
      "minutes": 8,
      "instruction": "Heat the fan oven to 200°C. Toss the peppers and onion with the oil, paprika, cumin, garlic and half the salt in the tin.",
      "temperatureC": 200
    },
    {
      "minutes": 10,
      "instruction": "Roast the peppers until they soften and char at the edges. Put the rice on with the water and a pinch of salt, covered.",
      "temperatureC": 200
    },
    {
      "minutes": 6,
      "instruction": "Stir the beans, sweetcorn and prawns through the peppers. Roast until the prawns are pink and just firm.",
      "temperatureC": 200,
      "tip": "Prawns go from juicy to tough very quickly. Six minutes in a hot oven is usually enough."
    },
    {
      "minutes": 4,
      "instruction": "Add the lime juice and coriander, taste for salt, and serve over the rice."
