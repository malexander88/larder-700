  "steps": [
    {
      "minutes": 8,
      "instruction": "Slice the mushrooms, pak choi, ginger, garlic, chilli and spring onion. Rinse the rice."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in 180 g of the water with a pinch of salt, covered, for 10 minutes. Leave it covered.",
      "heat": "low hob"
    },
    {
      "minutes": 6,
      "instruction": "Warm the oil and fry the mince, breaking it up, until it is no longer pink.",
      "heat": "medium hob"
    },
    {
      "minutes": 4,
      "instruction": "Add the ginger, garlic, chilli and mushrooms and cook for 2 minutes.",
      "heat": "medium hob"
    },
    {
      "minutes": 10,
      "instruction": "Pour in the coconut milk, the remaining water, tamari and salt. Simmer, then add the pak choi until it wilts.",
      "heat": "low hob"
    },
    {
      "minutes": 2,
      "instruction": "Stir in the lime juice, spring onion and coriander. Serve in deep bowls with the rice."
    }
  ],
