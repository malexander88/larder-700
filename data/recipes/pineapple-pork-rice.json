  "steps": [
    {
      "minutes": 6,
      "instruction": "Slice the pork, dice the pineapple and rinse the rice. Slice the chilli and spring onion."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in the water with a pinch of salt, covered, for 10 minutes. Spread it on a plate so steam escapes.",
      "heat": "low hob"
    },
    {
      "minutes": 5,
      "instruction": "Heat half the oil and stir-fry the pork until just cooked. Lift it out.",
      "heat": "high hob"
    },
    {
      "minutes": 5,
      "instruction": "Add the rest of the oil, garlic, chilli, pineapple and peas. Toss in the rice, pork and tamari until hot.",
      "heat": "high hob"
    },
    {
      "minutes": 2,
      "instruction": "Fold in the basil and spring onion and serve."
    }
