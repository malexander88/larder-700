  "steps": [
    {
      "minutes": 8,
      "instruction": "Toss the chicken with half the oil, half the lemon juice, the oregano, garlic and a pinch of salt. Put the couscous in a bowl, pour over the just-boiled water, cover and leave it.",
      "tip": "Couscous steams itself. Fluff it with a fork after five minutes, don't stir it into a paste."
    },
    {
      "minutes": 8,
      "instruction": "Heat a griddle or frying pan until hot and cook the chicken, turning, until browned and cooked through.",
      "heat": "medium-high hob"
    },
    {
      "minutes": 6,
      "instruction": "Stir the parsley and remaining oil through the couscous. Toss the cucumber, tomatoes, onion, olives and lettuce with the remaining lemon juice."
    },
    {
      "minutes": 5,
      "instruction": "Stir a pinch of salt into the yoghurt. Serve the chicken on the couscous and salad, with the yoghurt spooned over."
    }
  ],
