    {
      "minutes": 8,
      "instruction": "Cover the couscous with the boiling water and half the salt, then cover the bowl. Dice the cucumber and cut the turkey into strips. Stir the yoghurt with the mint, lemon juice and a pinch of salt."
    },
    {
      "minutes": 3,
      "instruction": "Toss the turkey with the harissa, half the oil and the rest of the salt."
    },
    {
      "minutes": 7,
      "instruction": "Fry the turkey until just cooked through.",
      "heat": "medium hob"
    },
    {
