  "steps": [
    {
      "minutes": 12,
      "instruction": "Heat the oven to 180°C fan. Cut the beef into chunks. Peel the swede, dice half and slice the rest thinly. Slice the onion. Stir the stock into the water."
    },
    {
      "minutes": 8,
      "instruction": "Warm the oil and brown the beef. Add the onion and diced swede for 3 minutes.",
      "heat": "medium hob"
    },
    {
      "minutes": 5,
      "instruction": "Stir in the tomato purée, rosemary, salt and pepper, then pour in the stock.",
      "heat": "medium hob"
    },
    {
      "minutes": 35,
      "instruction": "Overlap the swede slices on top, cover, and bake until the beef is tender. Uncover for the last 10 minutes so the top colours.",
      "temperatureC": 180,
      "tip": "Swede slices should be thin enough to bend. Thick ones stay hard."
