  "steps": [
    {
      "minutes": 8,
      "instruction": "Dice the mango, slice the pepper, onion and chilli, and rinse the rice. Stir the cumin and paprika into the mince with half the salt."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in the water with a pinch of salt, covered, for 10 minutes. Leave it covered off the heat.",
      "heat": "low hob"
    },
    {
      "minutes": 8,
      "instruction": "Warm the oil and fry the onion and pepper for 4 minutes. Add the mince and chilli and cook, breaking up the mince, until it is no longer pink.",
      "heat": "medium hob"
    },
    {
      "minutes": 3,
      "instruction": "Take the pan off the heat. Fold in the mango, lime juice and coriander. Serve over the rice."
    }
