  "steps": [
    {
      "minutes": 8,
      "instruction": "Heat the oven to 200°C fan. Stir the miso, ginger, tamari and half the sesame oil together. Rinse the rice and cut the broccoli."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in the water with a pinch of salt, covered, for 10 minutes. Leave it covered.",
      "heat": "low hob"
    },
    {
      "minutes": 8,
      "instruction": "Toss the broccoli with the remaining sesame oil and a pinch of salt. Put it in the tin with the salmon, skin-side down if it has skin. Roast for 8 minutes.",
      "temperatureC": 200
    },
    {
      "minutes": 6,
      "instruction": "Spread the miso glaze over the salmon and sprinkle the broccoli with sesame seeds. Roast until the salmon flakes.",
      "temperatureC": 200
    },
    {
      "minutes": 2,
      "instruction": "Serve the salmon and broccoli over the rice, with the spring onion on top."
    }
