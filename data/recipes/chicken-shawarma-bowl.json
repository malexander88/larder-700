  "steps": [
    {
      "minutes": 8,
      "instruction": "Toss the chicken with the oil, cumin, paprika, coriander, cinnamon, half the garlic and half the salt. Start the rice in the water.",
      "heat": "low hob"
    },
    {
      "minutes": 8,
      "instruction": "Fry the chicken over a medium-high heat until browned and cooked through. Stir the chickpeas through for the last minute to warm them.",
      "heat": "medium-high hob",
      "tip": "A little dark edge on the chicken is the point. Pale steamed strips won't taste like shawarma."
    },
    {
      "minutes": 6,
      "instruction": "Stir the remaining garlic and a pinch of salt into the yoghurt. Toss the cucumber, tomato, onion and lettuce with the lemon juice and parsley."
    },
    {
      "minutes": 6,
      "instruction": "Spoon the rice into bowls, top with chicken and chickpeas, then the salad and yoghurt."
