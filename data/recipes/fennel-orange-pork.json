  "steps": [
    {
      "minutes": 10,
      "instruction": "Heat the oven to 200°C fan. Cut the fennel into wedges and peel and slice the orange. Slice the garlic."
    },
    {
      "minutes": 8,
      "instruction": "Toss the fennel with half the oil, the rosemary, garlic and half the salt. Roast until it is starting to soften.",
      "temperatureC": 200
    },
    {
      "minutes": 6,
