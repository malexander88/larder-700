  "steps": [
    {
      "minutes": 8,
      "instruction": "Cut the chicken and dice the mango. Slice the onion and chilli. Grate the garlic and ginger. Rinse the rice."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in the water with a pinch of salt, covered, for 10 minutes. Leave it covered.",
      "heat": "low hob"
    },
    {
      "minutes": 6,
      "instruction": "Warm the oil and soften the onion. Stir in the garlic, ginger, curry powder and chilli for a minute.",
      "heat": "medium hob"
    },
    {
      "minutes": 12,
      "instruction": "Add the chicken and cook until it is no longer pink. Pour in the coconut milk and half the mango, then simmer until the chicken is cooked and the sauce is thick.",
      "heat": "medium hob"
    },
    {
      "minutes": 3,
      "instruction": "Fold in the spinach and the rest of the mango. Taste for salt, scatter with coriander and serve with the rice."
    }
