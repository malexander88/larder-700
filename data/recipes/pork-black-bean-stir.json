  "steps": [
    {
      "minutes": 8,
      "instruction": "Slice the pork, pepper, garlic, ginger and spring onion. Drain the beans. Stir the cornflour into the tamari with 2 tablespoons of water."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in the rest of the water with a pinch of salt, covered, for 10 minutes. Leave it covered.",
      "heat": "low hob"
    },
    {
      "minutes": 5,
      "instruction": "Heat the sesame oil until hot and stir-fry the pork until it just loses its pink colour. Lift it out.",
      "heat": "high hob"
    },
    {
      "minutes": 6,
      "instruction": "Stir-fry the pepper, garlic and ginger for 2 minutes. Return the pork with the beans, sauce and chilli. Toss until the sauce turns glossy.",
      "heat": "high hob"
    },
    {
      "minutes": 2,
      "instruction": "Fold in the spring onion and serve over the rice."
    }
