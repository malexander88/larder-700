  "steps": [
    {
      "minutes": 6,
      "instruction": "Soak the noodles in freshly boiled water until they bend, then drain. Slice the pak choi and spring onion. Stir the gochujang into 3 tablespoons of water."
    },
    {
      "minutes": 6,
      "instruction": "Heat the sesame oil and fry the mince until browned, breaking it up as it cooks.",
      "heat": "medium hob"
    },
    {
