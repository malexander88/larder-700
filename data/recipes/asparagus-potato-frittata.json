  "steps": [
    {
      "minutes": 6,
      "instruction": "Slice the potatoes and spring onion. Snap the woody ends off the asparagus and cut the stalks into short lengths. Beat the eggs with the parsley, pepper and half the salt."
    },
    {
      "minutes": 10,
      "instruction": "Simmer the potatoes in the water with the rest of the salt until just tender. Add the asparagus for the last 2 minutes, then drain.",
      "heat": "medium hob"
    },
    {
      "minutes": 4,
      "instruction": "Warm the oil in the frying pan and scatter in the potatoes, asparagus and spring onion.",
      "heat": "medium hob"
    },
    {
      "minutes": 8,
      "instruction": "Pour in the eggs, crumble the feta over the top and cook on a low heat until the edges are set and the middle is still slightly soft. Cover if the top needs help.",
      "heat": "low hob",
      "tip": "A low flame keeps the bottom from going leathery before the eggs set."
    }
