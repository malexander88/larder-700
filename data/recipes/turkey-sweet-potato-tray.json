  "steps": [
    {
      "minutes": 10,
      "instruction": "Heat the oven to 200°C fan. Cut the sweet potato and onion into wedges and the broccoli into florets. Stir the paprika, cumin, garlic, oil, lime juice and salt together."
    },
    {
      "minutes": 8,
      "instruction": "Toss the sweet potato and onion with two thirds of the spice mix. Roast them until the potato is starting to soften.",
      "temperatureC": 200
    },
    {
      "minutes": 6,
      "instruction": "Rub the turkey with the rest of the spice mix."
    },
    {
      "minutes": 16,
      "instruction": "Add the turkey and broccoli to the tin. Roast until the turkey is cooked through and the broccoli is charred at the tips.",
      "temperatureC": 200,
      "tip": "Turkey breast dries out if it overcooks. It is ready when the centre is no longer pink."
    },
    {
      "minutes": 2,
      "instruction": "Rest for a couple of minutes, then scatter with coriander and serve from the tin."
