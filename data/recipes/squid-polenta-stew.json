  "steps": [
    {
      "minutes": 8,
      "instruction": "Slice the squid and pat it dry. Chop the onion and parsley. Slice the garlic and halve the olives."
    },
    {
      "minutes": 8,
      "instruction": "Warm half the oil and soften the onion. Add the garlic and chilli, then the tomatoes, olives and half the salt. Simmer until slightly thick.",
      "heat": "medium hob"
    },
    {
      "minutes": 12,
      "instruction": "Meanwhile whisk the polenta into the boiling water with the rest of the salt. Stir over a low heat until it is thick and soft.",
      "heat": "low hob"
    },
    {
      "minutes": 4,
      "instruction": "Stir the squid into the tomato sauce and cook only until it turns opaque. Add the parsley and the rest of the oil.",
      "heat": "medium hob"
    },
    {
      "minutes": 2,
      "instruction": "Spoon the polenta into bowls and top with the squid stew."
    }
