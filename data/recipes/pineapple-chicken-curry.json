  "steps": [
    {
      "minutes": 8,
      "instruction": "Slice the chicken and pepper, dice the pineapple and pick the basil. Rinse the rice."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in the water with a pinch of salt, covered, for 10 minutes. Leave it covered.",
      "heat": "low hob"
    },
    {
      "minutes": 4,
      "instruction": "Warm the oil and fry the curry paste for a minute until fragrant.",
      "heat": "medium hob"
    },
    {
      "minutes": 6,
      "instruction": "Add the chicken and pepper and cook until the chicken is no longer pink.",
      "heat": "medium hob"
    },
    {
      "minutes": 6,
      "instruction": "Pour in the coconut milk and salt and simmer. Add the pineapple for the last 2 minutes.",
      "heat": "low hob"
    },
    {
      "minutes": 2,
      "instruction": "Stir in the lime juice and basil and serve the curry with the rice."
