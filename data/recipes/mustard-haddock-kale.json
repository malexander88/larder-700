  "steps": [
    {
      "minutes": 8,
      "instruction": "Heat the oven to 200°C fan. Halve the potatoes and strip the kale. Stir the mustard, lemon juice, half the oil and half the salt together."
    },
    {
      "minutes": 16,
      "instruction": "Toss the potatoes with the rest of the oil and salt and roast until they are starting to soften.",
      "temperatureC": 200
    },
    {
      "minutes": 4,
      "instruction": "Scatter the kale in the tin and lay the haddock on top. Spoon over the mustard dressing."
    },
    {
      "minutes": 12,
      "instruction": "Roast until the haddock flakes and the kale has wilted at the edges.",
      "temperatureC": 200
    },
    {
      "minutes": 2,
      "instruction": "Scatter the parsley over the haddock, potatoes and kale, and serve from the tin."
    }
