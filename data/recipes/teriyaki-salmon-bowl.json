  "steps": [
    {
      "minutes": 10,
      "instruction": "Stir the tamari, honey, ginger, garlic and vinegar together. Start the rice in 180 g of the water, covered.",
      "heat": "low hob"
    },
    {
      "minutes": 6,
      "instruction": "Heat the rapeseed oil and cook the salmon, skin-side down if it has skin, for 3 minutes. Turn it and pour in the sauce.",
      "heat": "medium hob",
      "tip": "Don't move the salmon for the first minutes or the glaze tears the flesh."
    },
    {
      "minutes": 6,
      "instruction": "Baste the salmon as the sauce reduces to a shine. Lift the fish out. Toss the broccoli and pak choi in the pan with a splash of water until just tender.",
      "heat": "medium hob"
    },
    {
      "minutes": 4,
      "instruction": "Add the sesame oil. Slice the salmon and serve it over the rice with the greens, the remaining glaze and the spring onion."
    }
