  "steps": [
    {
      "minutes": 8,
      "instruction": "Heat the oven to 190°C fan. Slice the leek and the potatoes. Stir the cornflour into 2 tablespoons of the milk until smooth."
    },
    {
      "minutes": 10,
      "instruction": "Warm the oil and soften the leek and potatoes for 8 minutes, with a splash of the milk if they catch. Add the spinach and let it collapse, then scrape the vegetables into a bowl.",
      "heat": "medium hob"
    },
    {
      "minutes": 6,
      "instruction": "Pour the rest of the milk into the pan with the cornflour mix, mustard, salt and pepper. Stir until it thickens, then take it off the heat.",
      "heat": "medium hob"
    },
    {
      "minutes": 4,
      "instruction": "Fold the haddock, leek, spinach, parsley and lemon juice into the sauce. Spread it in the pan and cover with the oats and a thread of the remaining oil."
    },
    {
      "minutes": 16,
      "instruction": "Bake until the oats are golden and the fish is opaque in the centre.",
      "temperatureC": 190
    }
