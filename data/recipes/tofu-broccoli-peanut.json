  "steps": [
    {
      "minutes": 8,
      "instruction": "Dry and cube the tofu. Cut the broccoli. Stir the peanut butter, lime juice, tamari, garlic, chilli and 3 tablespoons of water into a sauce. Rinse the rice."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in the remaining water with a pinch of salt, covered, for 10 minutes. Leave it covered.",
      "heat": "low hob"
    },
    {
      "minutes": 6,
      "instruction": "Heat the oil and fry the tofu until golden. Lift it out.",
      "heat": "medium hob"
    },
    {
      "minutes": 5,
      "instruction": "Stir-fry the broccoli with a splash of water until bright. Return the tofu, add the sauce, and toss.",
      "heat": "high hob"
    },
    {
      "minutes": 2,
      "instruction": "Spoon the tofu and broccoli over the rice and finish with the spring onion."
