  "steps": [
    {
      "minutes": 8,
      "instruction": "Soften the onion and pepper in the oil for 6 minutes. Stir in the garlic, paprika, cumin, oregano and chilli flakes and cook for a minute.",
      "heat": "medium hob"
    },
    {
      "minutes": 15,
      "instruction": "Add all three beans, the tomatoes, tomato purée, sweetcorn and stock cube. Simmer, uncovered, until the sauce is thick and the beans are coated.",
      "heat": "medium hob",
      "tip": "A thick chilli, not a soup. If it splutters, put the lid on ajar."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in the water with a pinch of salt while the chilli simmers.",
      "heat": "low hob"
    },
    {
      "minutes": 2,
      "instruction": "Taste for salt, stir through most of the coriander and serve over the rice with the rest on top."
