  "steps": [
    {
      "minutes": 8,
      "instruction": "Slice the squid into rings and pat it dry. Dice the pineapple and slice the pepper. Pick the basil. Rinse the rice."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in the water with a pinch of salt, covered, for 10 minutes. Leave it covered.",
      "heat": "low hob"
    },
    {
      "minutes": 4,
      "instruction": "Warm the oil and fry the curry paste for a minute until it smells fragrant.",
      "heat": "medium hob"
    },
    {
      "minutes": 5,
      "instruction": "Add the pepper and pineapple and stir for 2 minutes. Pour in the coconut milk, tamari and salt and bring it to a simmer.",
      "heat": "medium hob"
    },
    {
      "minutes": 4,
      "instruction": "Add the squid and cook only until the rings turn opaque.",
      "heat": "medium hob",
      "tip": "Squid turns rubbery if it simmers. Take it off the heat as soon as it is white."
    },
    {
      "minutes": 2,
      "instruction": "Stir in the lime juice and basil and serve with the rice."
    }
  ],
