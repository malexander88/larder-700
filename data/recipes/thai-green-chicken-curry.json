  "steps": [
    {
      "minutes": 8,
      "instruction": "Warm the oil and fry the curry paste for a minute until it smells fragrant. Stir in 50 g of the water and the stock cube so the paste loosens.",
      "heat": "medium hob",
      "tip": "Frying the paste in oil, not just boiling it, is what makes a curry taste finished."
    },
    {
      "minutes": 12,
      "instruction": "Add the aubergine and pepper and cook for 4 minutes. Add the chicken, green beans, coconut milk and the rest of the water. Simmer until the chicken is cooked and the aubergine is soft.",
      "heat": "medium hob"
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in a separate pan with a pinch of salt while the curry simmers.",
      "heat": "low hob"
    },
    {
      "minutes": 2,
      "instruction": "Stir in the tamari, lime juice and coriander. Taste, and add another squeeze of lime if it wants brightness. Serve with the rice."
    }
