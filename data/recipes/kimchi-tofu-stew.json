  "steps": [
    {
      "minutes": 8,
      "instruction": "Cube the tofu and pat it dry. Soak the noodles until they bend, then drain. Chop the kimchi and slice the mushrooms, pak choi, ginger, garlic and spring onion."
    },
    {
      "minutes": 4,
      "instruction": "Warm the sesame oil and fry the ginger, garlic and kimchi for 2 minutes.",
      "heat": "medium hob"
    },
    {
      "minutes": 6,
      "instruction": "Add the mushrooms and gochujang and stir until the paste loosens.",
      "heat": "medium hob"
    },
    {
      "minutes": 8,
      "instruction": "Pour in the water and salt, add the tofu, noodles and pak choi, and simmer until the leaves wilt and the tofu is hot.",
      "heat": "low hob"
    },
    {
      "minutes": 2,
      "instruction": "Scatter with spring onion and serve in deep bowls."
    }
