  "steps": [
    {
      "minutes": 6,
      "instruction": "Soak the noodles in freshly boiled water until they bend, then drain. Slice the pak choi, carrot, garlic and spring onion. Beat the eggs with a pinch of salt."
    },
    {
      "minutes": 3,
      "instruction": "Heat half the sesame oil and scramble the eggs until just set. Tip them onto a plate.",
      "heat": "medium hob"
    },
    {
      "minutes": 5,
      "instruction": "Add the rest of the oil and stir-fry the carrot, pak choi stems and garlic for 2 minutes. Add the leaves.",
      "heat": "high hob"
    },
    {
      "minutes": 4,
      "instruction": "Toss in the noodles, tamari, pepper and chilli. Fold the egg and spring onion through and serve.",
      "heat": "high hob",
      "tip": "Grind the pepper coarsely. Fine dust disappears into the noodles."
    }
