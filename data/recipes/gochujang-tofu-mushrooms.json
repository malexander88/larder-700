  "steps": [
    {
      "minutes": 8,
      "instruction": "Cube and dry the tofu. Quarter the mushrooms. Rinse the rice. Stir the gochujang and tamari into 3 tablespoons of water."
    },
    {
      "minutes": 12,
      "instruction": "Cook the rice in the remaining water with a pinch of salt, covered, for 10 minutes. Leave it covered.",
      "heat": "low hob"
    },
    {
      "minutes": 6,
      "instruction": "Warm the sesame oil and fry the tofu until golden on two sides. Lift it out.",
      "heat": "medium hob"
    },
    {
      "minutes": 6,
      "instruction": "Fry the mushrooms and garlic until the mushrooms colour. Return the tofu, pour in the gochujang mix and bubble until it turns glossy.",
      "heat": "medium hob"
    },
    {
      "minutes": 3,
      "instruction": "Fold the spinach through the rice so it wilts. Spoon the tofu and mushrooms on top with spring onion and sesame seeds."
    }
