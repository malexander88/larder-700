  "steps": [
    {
      "minutes": 8,
      "instruction": "Halve the potatoes. Slice the onion and grate the garlic and ginger."
    },
    {
      "minutes": 10,
      "instruction": "Simmer the potatoes in the water with a pinch of salt until nearly tender, then drain.",
      "heat": "medium hob"
    },
    {
      "minutes": 6,
      "instruction": "Warm the oil and soften the onion. Stir in the garlic, ginger, turmeric and cumin for a minute.",
      "heat": "medium hob"
    },
    {
      "minutes": 8,
      "instruction": "Add the potatoes, tomatoes and the rest of the salt. Cover and cook until the potatoes are soft.",
      "heat": "medium hob"
    },
    {
      "minutes": 8,
      "instruction": "Make spaces in the pan, crack in the eggs, cover, and cook until the whites are set. Fold in the spinach.",
      "heat": "low hob"
    },
    {
      "minutes": 2,
      "instruction": "Scatter with coriander and bring the pan to the table."
    }
