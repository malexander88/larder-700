  "steps": [
    {
      "minutes": 8,
      "instruction": "Separate the little gem leaves and rinse them. Dice the pepper, tomatoes and onion. Mix the tomato and half the onion with half the lime juice and a pinch of salt for a quick salsa."
    },
    {
      "minutes": 6,
      "instruction": "Warm the oil and fry the remaining onion for a minute. Add the turkey, garlic, paprika, cumin, oregano, salt and pepper and cook, breaking up the mince, until browned and cooked through.",
      "heat": "medium-high hob",
      "tip": "A spoonful of water at the end loosens the crusty bits into a light sauce."
    },
    {
      "minutes": 2,
      "instruction": "Stir the diced pepper into the mince just to warm it, then add the rest of the lime juice and the coriander."
    },
    {
      "minutes": 2,
      "instruction": "Spoon the mince into the lettuce leaves and top with salsa and avocado. Eat with your hands, over a plate."
    }
