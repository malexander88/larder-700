  "steps": [
    {
      "minutes": 8,
      "instruction": "Slice the pork, cabbage, mushrooms, ginger, carrot and spring onion. Soak the noodles in boiled water until they bend, then drain."
    },
    {
      "minutes": 6,
      "instruction": "Warm the sesame oil and brown the pork for a couple of minutes. Add the ginger.",
      "heat": "medium hob"
    },
    {
      "minutes": 12,
      "instruction": "Pour in the water with the cabbage, carrot, mushrooms and noodles. Simmer until the cabbage is tender and the pork is cooked through.",
      "heat": "medium hob"
    },
    {
      "minutes": 3,
      "instruction": "Ladle out a cup of broth, stir the miso into it, and pour it back. Do not boil. Scatter with spring onion.",
      "tip": "Boiling miso makes the soup bitter. Keep it below a simmer once the paste is in."
