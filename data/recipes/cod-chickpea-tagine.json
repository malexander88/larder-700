  "steps": [
    {
      "minutes": 8,
      "instruction": "Slice the onion and carrot. Grate the garlic. Drain the chickpeas and cut the cod into large pieces. Cover the couscous with the boiling water and a pinch of salt, then cover the bowl."
    },
    {
      "minutes": 8,
      "instruction": "Warm the oil and soften the onion and carrot.",
      "heat": "medium hob"
    },
    {
      "minutes": 3,
      "instruction": "Stir in the garlic, cumin and cinnamon for a minute.",
      "heat": "medium hob"
    },
    {
      "minutes": 12,
      "instruction": "Add the tomatoes, chickpeas and salt. Cover and simmer until the carrot is tender.",
      "heat": "low hob"
    },
    {
      "minutes": 6,
      "instruction": "Lay the cod on top, cover, and cook until it flakes. Add the lemon juice and coriander. Fluff the couscous and serve the tagine on top.",
      "heat": "low hob",
      "tip": "Keep the heat low so the cod stays in large flakes."
    }
