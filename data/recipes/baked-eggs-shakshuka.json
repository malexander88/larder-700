  "steps": [
    {
      "minutes": 8,
      "instruction": "Warm the oil and soften the onion and pepper for 6 minutes. Stir in the garlic, cumin, paprika and chilli flakes for a minute.",
      "heat": "medium hob"
    },
    {
      "minutes": 6,
      "instruction": "Add the tomatoes, chickpeas and salt. Simmer until the sauce is thick enough that an egg would sit in a hollow rather than disappear.",
      "heat": "medium hob",
      "tip": "A watery sauce poaches the eggs into a grey film. Reduce it first."
    },
    {
      "minutes": 8,
      "instruction": "Stir in the spinach. Make four wells and crack an egg into each. Cover and cook gently until the whites set and the yolks are still soft.",
      "heat": "low hob"
    },
    {
      "minutes": 6,
      "instruction": "Crumble over the feta and coriander, grind on a little pepper and bring the pan to the table. Share two eggs each, with plenty of the sauce."
    }
