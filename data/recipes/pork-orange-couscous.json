  "steps": [
    {
      "minutes": 8,
      "instruction": "Put the couscous in a bowl, stir in half the salt and the boiling water, cover and leave it to swell. Chop the orange and parsley. Slice the onion and pork."
    },
    {
      "minutes": 3,
      "instruction": "Toss the pork with the cumin, paprika and a pinch of salt."
    },
    {
      "minutes": 6,
      "instruction": "Warm the oil and fry the pork until browned and just cooked through.",
      "heat": "medium hob"
    },
    {
      "minutes": 4,
      "instruction": "Fluff the couscous with a fork. Fold in the orange, onion, parsley, rocket, lemon juice and the rest of the oil. Serve the pork on top."
    }
