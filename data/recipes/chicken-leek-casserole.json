  "steps": [
    {
      "minutes": 8,
      "instruction": "Warm the oil and brown the chicken on two sides, then lift it out. Season it as it goes in.",
      "heat": "medium-high hob"
    },
    {
      "minutes": 6,
      "instruction": "Add the leek and cook until it softens. Stir in the garlic and mushrooms.",
      "heat": "medium hob",
      "tip": "Leeks hide grit. Slice them, then swish in a bowl of water and lift them out."
    },
    {
      "minutes": 18,
      "instruction": "Return the chicken with the potatoes, mustard, stock cube and water. Cover and simmer until the potatoes are tender and the chicken is cooked through.",
      "heat": "medium hob"
    },
    {
      "minutes": 6,
      "instruction": "Mix the cornflour with a splash of cold water, stir it in and simmer until the sauce thickens. Fold in the spinach and parsley, taste, and serve in deep bowls."
    },
    {
      "minutes": 2,
      "instruction": "Let it stand a minute so the spinach wilts fully, then share it out, potatoes and all."
    }
