  "steps": [
    {
      "minutes": 6,
      "instruction": "Warm half the oil and soften the onion for 4 minutes. Add the garlic and chilli flakes for 30 seconds.",
      "heat": "medium hob"
    },
    {
      "minutes": 12,
      "instruction": "Stir in the orzo, tomatoes, crumbled stock cube and water. Simmer, stirring often, until the orzo is tender and most of the liquid has been absorbed.",
      "heat": "medium hob",
      "tip": "Orzo sticks if you ignore it. A stir every minute or so is enough."
    },
    {
      "minutes": 4,
      "instruction": "Push the orzo aside, add the remaining oil and fry the prawns for a minute a side until pink.",
      "heat": "medium-high hob"
    },
    {
      "minutes": 4,
      "instruction": "Fold in the spinach, lemon juice and parsley and let the leaves wilt. Taste for salt and serve straight away."
    }
