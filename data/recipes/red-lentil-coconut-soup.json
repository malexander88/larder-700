  "steps": [
    {
      "minutes": 8,
      "instruction": "Rinse the lentils. Peel and dice the sweet potato. Chop the onion and grate the garlic and ginger."
    },
    {
      "minutes": 6,
      "instruction": "Warm the oil and soften the onion. Stir in the garlic, ginger, turmeric, cumin and chilli flakes for a minute.",
      "heat": "medium hob"
    },
    {
      "minutes": 18,
      "instruction": "Add the lentils, sweet potato, water and salt. Cover and simmer until the lentils have collapsed and the potato is soft.",
      "heat": "low hob"
    },
    {
      "minutes": 4,
      "instruction": "Stir in the coconut milk and warm it through. Mash a few pieces of potato if you want a thicker soup.",
      "heat": "low hob"
    },
    {
      "minutes": 2,
      "instruction": "Add the lime juice and coriander, and serve."
    }
