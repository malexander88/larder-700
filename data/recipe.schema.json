{
  "$ref": "#/definitions/Recipe",
  "definitions": {
    "Recipe": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 8,
          "maxLength": 70
        },
        "summary": {
          "type": "string",
          "minLength": 40,
          "maxLength": 280
        },
        "cuisine": {
          "type": "string",
          "enum": [
            "Italian",
            "Indian",
            "Mexican",
            "Chinese",
            "Thai",
            "Mediterranean",
            "British",
            "Middle Eastern",
            "Japanese"
          ]
        },
        "protein": {
          "type": "string",
          "enum": [
            "chicken",
            "beef",
            "pork",
            "fish",
            "seafood",
            "turkey",
            "tofu",
            "eggs",
            "legumes"
          ]
        },
        "dietary": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "vegetarian",
              "vegan",
              "gluten-free",
              "dairy-free",
              "high-protein",
              "low-carb"
            ]
          }
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "moderate"
          ]
        },
        "servings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "prepMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "cookMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2,
                "maxLength": 80
              },
              "notes": {
                "type": "string",
                "minLength": 2,
                "maxLength": 140
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 8
        },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nutritionId": {
                "type": "string",
                "minLength": 2,
                "maxLength": 60
              },
              "grams": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 5000
              },
              "prepNote": {
                "type": "string",
                "minLength": 2,
                "maxLength": 140
              },
              "optional": {
                "type": "boolean"
              }
            },
            "required": [
              "nutritionId",
              "grams"
            ],
            "additionalProperties": false
          },
          "minItems": 5,
          "maxItems": 30
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "instruction": {
                "type": "string",
                "minLength": 40,
                "maxLength": 800
              },
              "minutes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 180
              },
              "temperatureC": {
                "type": "integer",
                "minimum": 80,
                "maximum": 250
              },
              "heat": {
                "type": "string",
                "minLength": 2,
                "maxLength": 80
              },
              "tip": {
                "type": "string",
                "minLength": 8,
                "maxLength": 280
              }
            },
            "required": [
              "instruction",
              "minutes"
            ],
            "additionalProperties": false
          },
          "minItems": 4,
          "maxItems": 14
        },
        "image": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^[a-z0-9-]+\\.webp$"
            },
            "alt": {
              "type": "string",
              "minLength": 12,
              "maxLength": 180
            },
            "credit": {
              "type": "string",
              "minLength": 2,
              "maxLength": 180
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            },
            "license": {
              "type": "string",
              "enum": [
                "Unsplash License",
                "Pexels License",
                "CC0",
                "CC0 1.0",
                "CC BY 2.0",
                "CC BY 2.5",
                "CC BY 3.0",
                "CC BY 4.0",
                "CC BY-SA 2.0",
                "CC BY-SA 2.5",
                "CC BY-SA 3.0",
                "CC BY-SA 4.0",
                "Public domain",
                "Public Domain"
              ]
            }
          },
          "required": [
            "file",
            "alt",
            "credit",
            "sourceUrl",
            "license"
          ],
          "additionalProperties": false
        },
        "statedPerServing": {
          "type": "object",
          "properties": {
            "calories": {
              "type": "number",
              "minimum": 0
            },
            "protein": {
              "type": "number",
              "minimum": 0
            },
            "carbs": {
              "type": "number",
              "minimum": 0
            },
            "fat": {
              "type": "number",
              "minimum": 0
            },
            "fibre": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "calories",
            "protein",
            "carbs",
            "fat",
            "fibre"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "slug",
        "title",
        "summary",
        "cuisine",
        "protein",
        "dietary",
        "difficulty",
        "servings",
        "prepMinutes",
        "cookMinutes",
        "equipment",
        "ingredients",
        "steps",
        "image",
        "statedPerServing"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe"
}
